# Copy this file to .env before running the app.

# SQLite (default, zero setup). For Postgres, use e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/mini_ops_erp"
DATABASE_URL="file:./dev.db"

# Secret used to sign JWTs - change this in any real deployment.
JWT_SECRET="change-this-super-secret-key"

# Access token lifetime
JWT_EXPIRES_IN="8h"

PORT=4000
